{
  "name": "research-cell-monorepo",
  "version": "1.0.0",
  "description": "Unified React Native (Expo) & Node.js MySQL (Hostinger) Research Cell App",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/src/server.js",
    "server:watch": "node --watch server/src/server.js",
    "setup:db": "node server/src/setupDb.js",
    "dev": "concurrently --raw --kill-others \"npm run server\" \"npx expo start\""
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "express": "^4.19.2",
    "mysql2": "^3.9.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2"
  },
  "private": true
}
